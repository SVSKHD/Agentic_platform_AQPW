# Copy to .env for local development. Never commit real values.
# Use separate credentials for development, staging and production (spec §13).
# Optional integrations are all-or-nothing: set every variable in a group or none.

# ---- Core (required) ----
NODE_ENV=development            # development | test | staging | production
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info                  # debug/trace are rejected in staging/production

MONGODB_URI=mongodb://localhost:27017/unified_ai_platform   # platform's OWN database, never AquaKart's
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

# HMAC key for API key hashing, min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates every issued API key.
API_KEY_PEPPER=

# Comma-separated browser origins. '*' is rejected outside development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- LLM gateway ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=             # optional attribution (HTTP-Referer)
OPENROUTER_APP_NAME=            # optional attribution (X-Title)
DEFAULT_LLM_MODEL=              # an OpenRouter model id; no default is hardcoded
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=16

# ---- Agents ----
AGENT_MAX_ATTEMPTS=2            # total attempts per agent job (1 retry); capped at 2 by owner rule

# ---- PawSattva (Firestore, direct Admin SDK writes in review state) — Phase 3 ----
# Service account for the Admin SDK. Keep 
 escapes in the private key on one line.
# Grant the service account only the Firestore access it needs (see docs/integrations/pawsattva.md).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- AquaKart (MongoDB, direct writes in draft state) — Phase 2/3 ----
# Dedicated least-privilege user: read on products/categories, write only on blogs + SEO collections.
# Must NOT be the platform database.
AQUAKART_MONGODB_URI=

# ---- SEO cycle ----
SEO_CYCLE_DAYS=10               # deadline: SEO changes due every N days
SEO_SUGGESTION_LEAD_DAYS=1      # suggestions generated N days before the deadline (day 9 of 10)

# ---- Reel rendering: self-hosted MoneyPrinterTurbo — Phase 5 ----
# Internal URL only; never expose MPT publicly. MONEYPRINTER_API_KEY must equal MPT's [app] api_key
# (MPT accepts unauthenticated requests when its key is empty). See docs/integrations/moneyprinter.md.
MONEYPRINTER_BASE_URL=          # e.g. http://moneyprinter:8080 in docker compose
MONEYPRINTER_API_KEY=

# ---- Meta / Instagram — Phase 4 ----
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# ---- S3-compatible object storage — Phase 4/5 ----
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Platform JWT (reserved; per-application JWT settings live on the application record) ----
JWT_ISSUER=
JWT_AUDIENCE=
